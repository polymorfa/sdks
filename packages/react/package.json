{
  "name": "@polymorfa/react",
  "version": "0.1.0-dev.0",
  "description": "React bindings for Polymorfa browser controllers",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@polymorfa/ui": "0.1.0-dev.0"
  },
  "peerDependencies": {
    "@polymorfa/browser": "0.1.0-dev.0",
    "react": ">=18.2.0 <20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
