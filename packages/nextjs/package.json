{
  "name": "@polymorfa/nextjs",
  "version": "0.1.0-dev.0",
  "description": "Server-only helpers for Polymorfa: one catch-all handler for Next.js, Express and Hono, client tokens, webhooks and media",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polymorfa/sdks.git",
    "directory": "packages/nextjs"
  },
  "bugs": {
    "url": "https://github.com/polymorfa/sdks/issues"
  },
  "homepage": "https://github.com/polymorfa/sdks#readme",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./express": {
      "types": "./dist/express.d.ts",
      "import": "./dist/express.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "import": "./dist/hono.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "peerDependencies": {
    "@polymorfa/sdk": ">=0.1.0-dev.0 <1"
  },
  "peerDependenciesMeta": {
    "@polymorfa/sdk": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
