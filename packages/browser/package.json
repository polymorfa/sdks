{
  "name": "@polymorfa/browser",
  "version": "0.1.0-dev.0",
  "description": "Framework-neutral Polymorfa browser transport and product controllers",
  "type": "module",
  "license": "MIT",
  "sideEffects": false,
  "main": "./dist/index.js",
