datasource db {
  provider = "postgresql"
}

model PolymorfaSessions {
  id String @id @map("_id")
  rev BigInt @map("_rev")
  versions Json @map("_v")
  sessionId String @map("session_id")
  phoneNumber String? @map("phone_number")
  waId String? @map("wa_id")
  pushName String? @map("push_name")
  phonePlatform String? @map("phone_platform")
  accountType String? @map("account_type")
  businessName String? @map("business_name")
  connected Boolean? @map("connected")
  status String? @map("status")
  statusReason String? @map("status_reason")
  loggedOutReason String? @map("logged_out_reason")
  loggedOutCode Float? @map("logged_out_code")
  @@map("polymorfa_sessions")
}

model PolymorfaChats {
  id String @id @map("_id")
  rev BigInt @map("_rev")
  versions Json @map("_v")
  sessionId String @map("session_id")
  chatId String @map("chat_id")
  jid String? @map("jid")
  kind String? @map("kind")
  phoneNumber String? @map("phone_number")
  bsuid String? @map("bsuid")
  username String? @map("username")
  name String? @map("name")
  archived Boolean? @map("archived")
  pinned Boolean? @map("pinned")
  muted Boolean? @map("muted")
  muteEndAt Float? @map("mute_end_at")
  markedUnread Boolean? @map("marked_unread")
  unreadCount Float? @map("unread_count")
  readOnly Boolean? @map("read_only")
  ephemeralExpiration Float? @map("ephemeral_expiration")
  lastMessageAt Float? @map("last_message_at")
  clearedAt Float? @map("cleared_at")
  deletedAt Float? @map("deleted_at")
  @@index([sessionId, lastMessageAt, id], map: "polymorfa_chats_by_activity")
  @@map("polymorfa_chats")
}

model PolymorfaMessages {
  id String @id @map("_id")
  rev BigInt @map("_rev")
  versions Json @map("_v")
  sessionId String @map("session_id")
  messageId String @map("message_id")
  chatId String? @map("chat_id")
  waMessageId String? @map("wa_message_id")
  cloudMessageId String? @map("cloud_message_id")
  fromMe Boolean? @map("from_me")
  senderId String? @map("sender_id")
  senderJid String? @map("sender_jid")
  pushName String? @map("push_name")
  timestamp Float? @map("timestamp")
  type String? @map("type")
  text String? @map("text")
  caption String? @map("caption")
  mimeType String? @map("mime_type")
  fileName String? @map("file_name")
  latitude Float? @map("latitude")
  longitude Float? @map("longitude")
  displayName String? @map("display_name")
  title String? @map("title")
  quotedId String? @map("quoted_id")
  pollOptions Json? @map("poll_options")
  extra Json? @map("extra")
  editedAt Float? @map("edited_at")
  revokedAt Float? @map("revoked_at")
  deletedAt Float? @map("deleted_at")
  starred Boolean? @map("starred")
  status String? @map("status")
  statusAt Float? @map("status_at")
  @@index([sessionId, chatId, timestamp, id], map: "polymorfa_messages_by_chat")
  @@map("polymorfa_messages")
}

