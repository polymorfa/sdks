{
  "name": "@polymorfa/sdk",
  "version": "0.1.0-dev.0",
  "description": "Handwritten Polymorfa server SDK for TypeScript, Node.js, and edge runtimes",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polymorfa/sdks.git",
    "directory": "packages/typescript"
  },
  "bugs": {
    "url": "https://github.com/polymorfa/sdks/issues"
  },
  "homepage": "https://github.com/polymorfa/sdks#readme",
  "keywords": [
    "polymorfa",
    "messaging",
    "sdk"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./history": {
      "types": "./dist/history/index.d.ts",
      "import": "./dist/history/index.js"
    },
    "./s3": {
      "types": "./dist/s3.d.ts",
      "import": "./dist/s3.js"
    },
    "./calls": {
      "types": "./dist/calls/index.d.ts",
      "import": "./dist/calls/index.js"
    },
    "./calls/internal": {
      "types": "./dist/calls/internal.d.ts",
      "import": "./dist/calls/internal.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.calls.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "generate:proto": "cd proto && buf generate --type whatsapp.HistorySync"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "@aws-sdk/client-s3": "^3.0.0",
    "@bufbuild/protobuf": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@aws-sdk/client-s3": {
      "optional": true
    },
    "@bufbuild/protobuf": {
      "optional": true
    }
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@bufbuild/buf": "^1.73.0",
    "@bufbuild/protobuf": "^2.16.0",
    "@bufbuild/protoc-gen-es": "^2.16.0"
  }
}
