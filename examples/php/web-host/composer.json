{
  "name": "polymorfa/example-web-host",
  "description": "Laravel Blade and Symfony hosts for existing Polymorfa Web Components",
  "type": "project",
  "require": {
    "php": ">=8.2",
    "polymorfa/sdk": "@dev",
    "laravel/framework": "^12.0",
