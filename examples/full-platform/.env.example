# Server-only credentials. Never expose these to the browser or commit real values.

# Leave POLYMORFA_PROJECT_TOKEN empty to run on built-in demo data, or set
# this to true to force demo data even when credentials are present.
ACME_DEMO_DATA=

# Project token (pmfa_pt_...). Used by MessagingClient, BridgeClient, and the
# project-scoped management Client.
POLYMORFA_PROJECT_TOKEN=
# Organization API key (pmfa_...). Used by the organization management Client
# for the admin area.
POLYMORFA_ORGANIZATION_API_KEY=

# Project bound to POLYMORFA_PROJECT_TOKEN.
POLYMORFA_PROJECT_ID=
POLYMORFA_PROJECT_SLUG=
# Default session (number) the support team works from.
POLYMORFA_SESSION=support
# Optional comma-separated extra sessions agents may address. Admins may
# address any session; agents otherwise only POLYMORFA_SESSION.
POLYMORFA_AGENT_SESSIONS=
# Session used to submit templates to Meta (a Cloud API session).
POLYMORFA_TEMPLATE_SESSION=

# Signing secret returned when /api/admin/webhooks creates the management
# webhook that points at /api/polymorfa/webhooks.
POLYMORFA_WEBHOOK_SECRET=
# Secret you choose for the Messaging webhook that /api/messaging/webhooks
# registers at /api/polymorfa/messaging-webhooks. Generate it with
# `openssl rand -base64 32`.
POLYMORFA_MESSAGING_WEBHOOK_SECRET=

# Public origin of this app, without a path. Used for webhook URLs, client
# token origins, and the same-origin check on state-changing requests.
# Required with credentials; in demo mode the request origin is used when empty.
APP_ORIGIN=http://localhost:3000

# Optional. Defaults to https://api.polymorfa.com.
POLYMORFA_API_BASE_URL=
