{
  "name": "polymorfa-sdks",
  "private": true,
  "description": "Workspace for the Polymorfa SDK packages",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polymorfa/sdks.git"
  },
  "workspaces": [
    "packages/typescript",
    "packages/calls",
    "packages/browser",
    "packages/ui",
    "packages/elements",
    "packages/react",
    "packages/store",
    "packages/nextjs",
    "packages/devtools",
    "examples/calls-example",
    "packages/storage"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @polymorfa/sdk",
    "build:workspaces": "npm run build --workspaces --if-present",
    "check:coverage": "node scripts/check-coverage.mjs --messaging contracts/openapi.messaging.json --platform contracts/openapi.platform.json --ledger contracts/coverage.json --strict",
    "check:names": "node scripts/check-retired-name.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" vitest.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:functions": "node scripts/check-functions.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/util-dynamodb": "^3.996.9",
    "@azure/cosmos": "^4.10.1",
    "@eslint/js": "^9.39.5",
    "@google-cloud/firestore": "^9.3.1",
    "@libsql/client": "^0.18.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "convex": "^1.46.0",
    "convex-test": "^0.0.61",
    "drizzle-orm": "^0.45.4",
    "esbuild": "^0.25.12",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.2",
    "miniflare": "^4.20260730.0",
    "mongodb": "^7.7.0",
    "mysql2": "^3.24.5",
    "pg": "^8.23.1",
    "postgres": "^3.4.9",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.29.1",
      "sharp": "^0.35.5"
    }
  }
}
