{
  "name": "polymorfa-sdks",
  "private": true,
  "description": "Workspace for the Polymorfa SDK packages",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/polymorfa/sdks.git"
  },
  "workspaces": [
    "packages/typescript",
    "packages/calls",
    "packages/browser",
    "packages/ui",
    "packages/elements",
    "packages/react",
    "packages/store",
    "packages/nextjs",
    "packages/devtools",
    "examples/calls-example"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build -w @polymorfa/sdk",
    "build:workspaces": "npm run build --workspaces --if-present",
    "check:coverage": "node scripts/check-coverage.mjs --messaging contracts/openapi.messaging.json --platform contracts/openapi.platform.json --ledger contracts/coverage.json --strict",
    "check:names": "node scripts/check-retired-name.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint \"packages/**/*.{ts,tsx}\" vitest.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "check:functions": "node scripts/check-functions.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^9.39.5",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.2",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.7"
  }
}
