                "idempotency_in_progress",
                "idempotency_completed",
                "idempotency_outcome_unknown",
                "call_claimed",
                "call_not_ringing",
                "connection_limit",
                "unsupported_for_connection",
                "call_permission_required",
                "invalid_sip_trunk",
                "calls_disabled",
