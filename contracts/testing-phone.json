  "schemas": {
    "TestingPhoneState": {
      "type": "object",
      "properties": {
        "connection": {
          "type": "string"
        },
        "phone": {
          "type": "string",
          "description": "The Test number, in E.164 format."
        },
        "online": {
          "type": "boolean",
          "description": "True while the simulated phone is running."
        },
        "devices": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "deviceId": {
                "type": "integer"
              }
            },
            "required": ["deviceId"]
          },
          "description": "Companions linked to the phone, such as Polymorfa's own connection and Inspector."
        }
      },
      "required": ["connection", "phone", "online", "devices"]
    },
    "PublicError": {
      "type": "object",
      "properties": {
        "error": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
