    "TestingPhoneMessageRequest": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^\\+[1-9]\\d{7,14}$",
          "description": "The phone number of another Test connection in the same project, in E.164 format."
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "required": ["to", "text"],
      "additionalProperties": false
    },
    "TestingPhoneMessage": {
      "type": "object",
      "properties": {
        "connection": {
          "type": "string"
        },
        "to": {
          "type": "string"
        },
        "messageId": {
          "type": "string",
          "nullable": true
        }
      },
      "required": ["connection", "to", "messageId"]
    },
    "TestingPhoneUnlink": {
      "type": "object",
      "properties": {
        "connection": {
