  "schemas": {
    "PlatformAccessClientToken": {
      "type": "object",
      "properties": {
        "token": {
          "type": "string",
          "description": "Client token with pmfa_ct_ prefix"
        },
        "expiresAt": {
          "type": "string"
        }
      },
      "required": ["token", "expiresAt"]
    },
    "PlatformAccessMintClientTokenRequest": {
      "type": "object",
      "properties": {
        "session": {
          "type": "string",
          "minLength": 1,
          "description": "ID of the session this token can access. Provide exactly one of `session` or `customer`."
        },
        "customer": {
          "type": "string",
          "format": "uuid",
          "description": "Polymorfa Customer ID. The token covers the numbers this Customer owns when it is minted, and only while the Customer still owns each one. Provide exactly one of `session` or `customer`. Requires the `customers:read` scope and enrollment in the Customer-scoped client tokens beta."
        },
        "allow": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mcp",
              "send_message",
              "send_reaction",
              "send_typing",
              "send_seen",
              "read_presence",
              "subscribe_presence",
              "read_contact",
              "voip_place",
              "voip_answer",
              "voip_signal",
              "chats_read",
              "chats_manage",
              "contact_write",
              "contact_delete"
            ]
          },
          "minItems": 0,
          "maxItems": 15,
          "description": "Immutable action ceiling, intersected with live client rules. Session allow requires the action-ceilings beta. With ceiling issuance enabled, session omission snapshots its configured actions. For a Customer, omission uses the original Customer action set. An empty session allow grants no actions; Customer allow must be non-empty. Regional actions are reserved for enrolled beta access."
        },
        "ephemeralId": {
          "type": "string",
          "minLength": 1,
          "description": "Your identifier for the browser or mobile user receiving this token."
        },
        "ttlSeconds": {
          "type": "integer",
          "description": "Token lifetime in seconds. Must be at least 1 and within the maximum allowed lifetime. Omit to use that maximum."
        }
      },
      "required": ["ephemeralId"]
    },
    "PlatformAccessMintClientTokenResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean",
          "enum": [true]
        },
        "data": {
          "$ref": "#/components/schemas/PlatformAccessClientToken"
        }
      },
      "required": ["success", "data"]
    },
