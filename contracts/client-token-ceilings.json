                "campaign_approval_stale",
                "campaign_variables_missing"
              ]
            },
            "message": {
              "type": "string"
            },
            "param": {
              "type": "string",
              "nullable": true
            },
            "request_id": {
              "type": "string",
              "description": "Matches the X-Request-Id response header. Include it when you contact support."
            },
            "request_log_url": {
              "type": "string",
              "format": "uri",
              "description": "Console page that shows this request. Returned only to organization and project credentials whose request was logged."
            }
          },
          "required": ["type", "code", "message", "param", "request_id"]
        },
        "data": {
          "type": "string",
          "nullable": true,
          "enum": [null],
          "description": "Always null for a failed request."
        },
        "docs": {
          "type": "string",
          "format": "uri"
        }
      },
      "required": ["error", "data", "docs"]
    },
    "PlatformAccessSetClientRulesRequest": {
      "type": "object",
      "properties": {
        "recipientMode": {
          "type": "string"
        },
        "allowedActions": {
          "type": "string",
          "maxLength": 1024,
          "default": ""
        },
        "rateLimit": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "maxDaily": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "allowedOrigins": {
          "type": "string",
          "maxLength": 8192,
          "default": ""
        },
        "enabled": {
          "type": "boolean"
        },
        "maxConcurrency": {
          "type": "integer",
          "minimum": 0,
          "default": 0
        },
        "allowedNumber": {
          "type": "string",
          "maxLength": 8192,
          "default": ""
        },
        "maxSetupsPerMinute": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600,
          "default": 0
        },
        "conversationTtlSeconds": {
          "type": "integer",
          "minimum": 300,
          "maximum": 604800,
          "default": 86400,
          "description": "How long, in seconds, a sender remains replyable in `conversation` mode after their latest inbound message. Must be between 300 (5 minutes) and 604800 (7 days). Defaults to 86400 (24 hours)."
        }
      },
      "required": ["recipientMode", "enabled"]
    },
    "PlatformAccessSuccessResponse": {
      "type": "object",
      "properties": {
        "success": {
          "type": "boolean"
        },
        "message": {
          "type": "string"
        }
      },
      "required": ["success"]
    }
  }
