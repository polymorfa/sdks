      "release": "unpublished"
    },
    "dotnet": {
      "testFile": "packages/dotnet/tests/Polymorfa.Sdk.Tests/NewsletterObservationTests.cs",
      "status": "source-implemented",
      "release": "unpublished"
    }
  }
}
