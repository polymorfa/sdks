                "type": "string"
              },
              "errorCode": {
                "type": "string"
              }
            },
            "description": "Payment provider transaction as WhatsApp reported it"
          },
          "messageId": {
            "type": "string",
            "description": "Message that carried a payment method confirmation"
          },
          "paymentMethod": {
            "type": "string",
            "example": "offsite_card_pay"
          },
          "lastFourDigits": {
            "type": "string"
          },
          "credentialId": {
            "type": "string",
            "description": "Your credential ID from the order's payment settings"
          },
          "paymentTimestamp": {
            "type": "integer",
            "description": "Unix time in seconds reported by WhatsApp"
          }
        },
        "required": [
          "kind",
          "reportedBy",
          "providerEventId",
          "referenceId",
          "conversation"
        ]
      },
      "CallEndedPayload": {
        "type": "object",
        "properties": {
          "from": {
            "type": "object",
            "nullable": true,
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[1-9][0-9]{0,18}$",
                "description": "Opaque Polymorfa resource ID. Keep this value as a string.",
                "example": "739182640518203"
              },
              "phoneNumber": {
                "type": "string"
              },
              "bsuid": {
                "type": "string"
              },
              "username": {
                "type": "string"
              },
              "parentBsuid": {
                "type": "string",
                "description": "Parent business-scoped user ID (`CC.ENT.\u2026`), present only when WhatsApp reports one for this person. It identifies the person across the business portfolios enrolled in one parent account. It cannot be used to send messages or block people; use `id` or `bsuid`.",
                "example": "US.ENT.11815799212886844830"
              }
            },
            "required": ["id"]
          },
          "callId": {
            "type": "string"
          },
          "durationSeconds": {
            "type": "integer",
            "description": "Total connected duration in seconds (0 if never answered).",
            "example": 42
          },
          "reason": {
            "type": "string",
            "description": "Termination reason: user_hangup | timeout | lost_connection | rejected | capacity | pod_lost | connection_failed | upstream_failed | call_restricted (WhatsApp refused the call because the number is restricted to calling people it has already chatted with).",
            "example": "user_hangup"
          },
          "direction": {
            "type": "string",
            "enum": ["inbound", "outbound"],
            "description": "Call direction.",
            "example": "inbound"
          },
          "hadVideo": {
            "type": "boolean",
            "description": "Whether the call carried video.",
            "example": false
          },
          "sessionConnection": {
            "type": "string",
            "enum": ["linked_device", "cloud_api"],
            "description": "Connection of the session that carries the call: a linked device or the WhatsApp Business Cloud API.",
            "example": "linked_device"
          }
        },
        "required": [
          "from",
          "callId",
          "durationSeconds",
          "reason",
          "direction",
          "hadVideo"
        ]
      },
      "ConversationRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Opaque Polymorfa resource ID. Keep this value as a string.",
            "example": "739182640518203"
          },
          "phoneNumber": {
            "type": "string"
          },
          "bsuid": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "parentBsuid": {
            "type": "string",
            "description": "Parent business-scoped user ID (`CC.ENT.\u2026`), present only when WhatsApp reports one for this person. It identifies the person across the business portfolios enrolled in one parent account. It cannot be used to send messages or block people; use `id` or `bsuid`.",
            "example": "US.ENT.11815799212886844830"
          },
          "sender": {
            "$ref": "#/components/schemas/IdentityRef"
          }
        },
        "required": ["id"]
      }
    }
  }
