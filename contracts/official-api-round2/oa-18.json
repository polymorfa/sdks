      "OrderPaymentUpdatedPayload": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["payment_status", "payment_method_selected"],
            "description": "`payment_status` when WhatsApp reports a payment status; `payment_method_selected` when the buyer confirmed a one-click payment method"
          },
          "reportedBy": {
            "type": "string",
            "enum": ["whatsapp"],
            "description": "Polymorfa relays this report; it does not process or confirm funds"
          },
          "providerEventId": {
            "type": "string",
            "description": "WhatsApp's notification or message ID"
          },
          "referenceId": {
            "type": "string",
            "description": "Your order reference ID from the order details message",
            "example": "order-1522"
          },
          "conversation": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "phoneNumber": {
