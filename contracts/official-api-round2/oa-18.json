  "components": {
    "schemas": {
      "IdentityRef": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Opaque Polymorfa resource ID. Keep this value as a string.",
            "example": "739182640518203"
          },
          "phoneNumber": {
            "type": "string"
          },
          "bsuid": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "parentBsuid": {
            "type": "string",
            "description": "Parent business-scoped user ID (`CC.ENT.\u2026`), present only when WhatsApp reports one for this person. It identifies the person across the business portfolios enrolled in one parent account. It cannot be used to send messages or block people; use `id` or `bsuid`.",
            "example": "US.ENT.11815799212886844830"
          }
        },
        "required": ["id"]
      },
      "ContactUpdatePayload": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Opaque Polymorfa resource ID. Keep this value as a string.",
            "example": "739182640518203"
          },
          "bsuid": {
            "type": "string"
          },
          "phoneNumber": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "parentBsuid": {
            "type": "string",
            "description": "Parent business-scoped user ID (`CC.ENT.\u2026`), present only when WhatsApp reports one for this person. It identifies the person across the business portfolios enrolled in one parent account. It cannot be used to send messages or block people; use `id` or `bsuid`.",
            "example": "US.ENT.11815799212886844830"
          },
          "identityChange": {
            "$ref": "#/components/schemas/ContactIdentityChange"
          },
          "fullName": {
            "type": "string"
          },
          "firstName": {
            "type": "string"
          },
          "pushName": {
            "type": "string"
          },
          "oldPushName": {
            "type": "string"
          },
          "businessName": {
            "type": "string"
          },
          "oldBusinessName": {
            "type": "string"
          },
          "pictureId": {
            "type": "string"
          },
          "pictureRemoved": {
            "type": "boolean"
          }
        },
        "required": ["id"]
      },
      "ContactIdentityChange": {
        "type": "object",
        "properties": {
          "reason": {
            "type": "string",
            "enum": ["phone_number_changed", "user_id_changed"],
            "description": "`phone_number_changed`: the person changed their phone number, which also gives them a new business-scoped user ID. `user_id_changed`: their business-scoped user ID changed and WhatsApp did not share a phone number."
          },
          "messageId": {
            "type": "string",
            "description": "WhatsApp's ID for the notification that reported the change."
          },
          "previous": {
            "$ref": "#/components/schemas/ContactPreviousIdentity"
          }
        },
        "required": ["reason", "messageId"],
        "description": "Present when WhatsApp reported that the person's identifiers changed. The event's own identity fields describe the new identity."
      },
      "ContactPreviousIdentity": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[1-9][0-9]{0,18}$",
            "description": "Opaque Polymorfa resource ID. Keep this value as a string.",
            "example": "739182640518203"
          },
          "bsuid": {
            "type": "string"
          },
          "parentBsuid": {
            "type": "string"
          }
        },
        "description": "The identity the person had before the change. `id` is the contact key of that earlier identity."
      },
