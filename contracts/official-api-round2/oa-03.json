  "components": {
    "schemas": {
      "QuickLinkStatus": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string",
            "enum": ["initial", "add_connection", "reauthorization"]
          },
          "connectionGoal": {
            "type": "string",
            "enum": ["single", "hybrid"]
          },
          "addConnection": {
            "type": "string",
            "enum": ["linked_devices", "official_api"]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "opened",
              "linked",
              "connected",
              "failed",
              "cancelled"
            ],
            "description": "`linked`: for Linked Devices, the device is linked and the recipient has not confirmed; for Meta Cloud API, the number is connected to Meta and is still being made ready to send. For Meta Cloud API, `connected` requires every readiness check to pass, a successful runtime connection, and the recipient's confirmation. `failed` carries the reason in `errorCode`."
          },
          "session": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "nullable": true
          },
          "openedAt": {
            "type": "string",
            "nullable": true
          },
          "connectedAt": {
            "type": "string",
            "nullable": true
          },
          "phone": {
            "type": "string",
            "nullable": true,
            "description": "Connected phone in E.164 once the link is connected."
          },
          "errorCode": {
            "type": "string",
            "nullable": true
          },
          "hybridPhase": {
            "type": "string",
            "nullable": true,
            "enum": [
              "cloud_setup",
              "linked_pairing",
              "repair_linked",
              "ready",
              null
            ]
          },
          "onboarding": {
            "type": "object",
            "nullable": true,
            "properties": {
              "stage": {
                "type": "string"
              },
              "connection": {
                "type": "string",
                "nullable": true
              },
              "coexistence": {
                "type": "boolean",
                "nullable": true
              },
              "contactsSync": {
                "type": "string"
              },
              "historySync": {
                "type": "string"
              },
              "historyProgress": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "errorCode": {
                "type": "string",
                "nullable": true
              },
              "sync": {
                "$ref": "#/components/schemas/CloudSyncStatus"
              }
            },
            "required": [
              "stage",
              "connection",
              "coexistence",
              "contactsSync",
              "historySync",
              "historyProgress",
              "errorCode",
              "sync"
            ],
            "description": "Durable connection and sync progress; omitted when the onboarding service is unavailable, null when no record exists. Sync request and delivery evidence are independent of the connection stage."
          }
        },
        "required": [
          "id",
          "purpose",
          "connectionGoal",
          "status",
          "session",
          "expiresAt",
          "openedAt",
          "connectedAt",
          "phone",
          "errorCode",
          "hybridPhase"
        ]
      },
      "CloudSyncStatus": {
        "type": "object",
        "properties": {
          "contacts": {
            "type": "object",
            "properties": {
              "request": {
                "type": "string",
                "enum": [
                  "not_applicable",
                  "not_requested",
                  "pending",
                  "requesting",
                  "accepted",
                  "declined",
                  "unknown"
                ],
                "description": "Accepted means Meta returned a request receipt; it does not prove all contacts were delivered. Unknown means a one-time request may have been accepted without a saved receipt."
              },
              "receiptRecorded": {
                "type": "boolean"
              }
            },
            "required": ["request", "receiptRecorded"]
          },
          "history": {
            "type": "object",
            "properties": {
              "request": {
                "type": "string",
                "enum": [
                  "not_applicable",
                  "not_requested",
                  "pending",
                  "requesting",
                  "accepted",
                  "declined",
                  "unknown"
                ]
              },
              "receiptRecorded": {
                "type": "boolean"
              },
              "delivery": {
                "type": "string",
                "enum": [
                  "not_applicable",
                  "not_requested",
                  "unconfirmed",
                  "partial",
                  "complete",
                  "declined"
                ],
                "description": "Partial and complete describe the latest history progress reported by Meta. Unconfirmed does not mean that no history exists."
              }
            },
            "required": ["request", "receiptRecorded", "delivery"]
          }
        },
        "required": ["contacts", "history"]
      },
      "PublicError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
