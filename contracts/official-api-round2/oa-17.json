        },
        "x-protocols": ["Meta Cloud API"]
      }
    }
  },
  "components": {
    "schemas": {
      "MarketingOnboardingUpdatedEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique event identifier"
          },
          "session": {
            "type": "string",
            "description": "Session that produced this event"
          },
          "externalId": {
            "type": "string",
            "description": "Integrator reference from the QuickLink that created this session. Included on session lifecycle events when supplied."
          },
          "timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp"
          },
          "event": {
            "type": "string",
            "enum": ["marketing.onboarding_updated"],
            "description": "Event type"
          },
          "payload": {
            "$ref": "#/components/schemas/MarketingOnboardingUpdatedPayload"
          }
        },
        "required": ["id", "session", "timestamp", "event", "payload"]
      },
      "ContactMarketingPreferenceUpdatedEvent": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Unique event identifier"
          },
          "session": {
            "type": "string",
            "description": "Session that produced this event"
          },
          "externalId": {
            "type": "string",
            "description": "Integrator reference from the QuickLink that created this session. Included on session lifecycle events when supplied."
          },
          "timestamp": {
            "type": "string",
            "description": "ISO 8601 timestamp"
          },
          "event": {
            "type": "string",
            "enum": ["contact.marketing_preference_updated"],
            "description": "Event type"
          },
          "payload": {
            "$ref": "#/components/schemas/ContactMarketingPreferencePayload"
          }
        },
        "required": ["id", "session", "timestamp", "event", "payload"]
      },
      "ContactMarketingPreferencePayload": {
        "type": "object",
        "properties": {
          "waId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "description": "WhatsApp user ID, preserved unchanged. It is not necessarily a phone number"
          },
          "preference": {
            "type": "string",
            "enum": ["stop", "resume"],
            "description": "`stop`: the person stopped marketing messages from your business; later marketing messages to them fail with WhatsApp error 131050 until they resume. Do not resend to them. `resume`: they accept marketing messages again"
          },
          "category": {
            "type": "string",
            "enum": ["marketing_messages"]
          },
          "phoneNumberId": {
            "type": "string",
            "description": "WhatsApp phone number ID of your Number"
          }
        },
        "required": ["waId", "preference", "category"]
      },
      "MarketingOnboardingUpdatedPayload": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["terms_signed", "ad_account_linked"],
            "description": "`terms_signed`: the business accepted the Marketing Messages terms for this WhatsApp Business Account. `ad_account_linked`: WhatsApp's older onboarding completion notice, which WhatsApp is retiring"
          },
          "wabaId": {
            "type": "string",
            "description": "WhatsApp Business Account the notice is about"
          },
          "ownerBusinessId": {
            "type": "string",
            "description": "Business portfolio that owns the account"
          },
          "metaEvent": {
            "type": "string",
            "enum": ["MM_LITE_TERMS_SIGNED", "AD_ACCOUNT_LINKED"],
            "description": "WhatsApp's `account_update` event value"
          }
        },
        "required": ["kind", "wabaId", "metaEvent"]
      },
      "PublicError": {
        "type": "object",
