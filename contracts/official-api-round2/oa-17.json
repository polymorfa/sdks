      "GetMarketingMessagesStatusResponse": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "enum": [true]
          },
          "data": {
            "$ref": "#/components/schemas/MarketingMessagesStatus"
          }
        },
        "required": ["success", "data"]
      },
      "MarketingMessagesStatus": {
        "type": "object",
        "properties": {
          "wabaId": {
            "type": "string",
            "description": "WhatsApp Business Account of the Number's Official API connection."
          },
          "onboarding": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["onboarded", "eligible", "unknown"],
                "description": "`onboarded`: WhatsApp reports the account onboarded to Marketing Messages. `eligible`: the account can onboard but has not. `unknown`: WhatsApp returned no status or a value it does not document."
              },
              "metaStatus": {
                "type": "string",
                "nullable": true,
                "description": "WhatsApp's `marketing_messages_onboarding_status` value, unchanged.",
                "example": "ONBOARDED"
              }
            },
            "required": ["status", "metaStatus"]
          },
          "terms": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "enum": ["signed", "requested", "not_started", "unknown"],
                "description": "Terms of service state of the business portfolio that owns the account."
              },
              "metaStatus": {
                "type": "string",
                "nullable": true,
                "description": "WhatsApp's value, unchanged: `TERM_OF_SERVICE_SIGNED`, `REQUEST_SENT` or `NOT_STARTED`.",
                "example": "TERM_OF_SERVICE_SIGNED"
              },
              "date": {
                "type": "string",
                "nullable": true,
                "description": "Date WhatsApp reports for the terms state (YYYY-MM-DD).",
                "example": "2025-08-13"
              }
            },
            "required": ["status", "metaStatus", "date"]
          },
          "cloudApiMarketingDisabled": {
            "type": "boolean",
            "nullable": true,
            "description": "True when the account refuses Marketing templates sent as ordinary messages (`marketing_disabled_on_cloud_api`). Null when WhatsApp did not report it."
          },
          "nextAction": {
            "type": "string",
            "enum": ["none", "accept_terms", "review_in_whatsapp_manager"],
            "description": "`accept_terms`: someone with full control of the business portfolio accepts the Marketing Messages terms in WhatsApp Manager (Overview, Alerts). `review_in_whatsapp_manager`: check the account in WhatsApp Manager. There is no API for either step."
          },
          "guideUrl": {
            "type": "string",
            "format": "uri",
            "description": "WhatsApp's onboarding guide for the terms step."
          },
          "observedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "wabaId",
          "onboarding",
          "terms",
          "cloudApiMarketingDisabled",
          "nextAction",
          "guideUrl",
          "observedAt"
        ]
      }
    }
  }
}
