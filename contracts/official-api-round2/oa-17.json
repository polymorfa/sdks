{
  "paths": {
    "/messaging/{session}/marketing-messages/status": {
      "get": {
        "operationId": "getMarketingMessagesStatus",
        "tags": ["Marketing Messages"],
        "summary": "Get Marketing Messages onboarding status",
        "description": "**Protocols:** Meta Cloud API\n\n**Required scope:** `sessions:read`\n\nReads WhatsApp's Marketing Messages onboarding status, terms of service state and Cloud API marketing setting for the Number's WhatsApp Business Account. The status can change between this read and a send; WhatsApp decides each send. Beta: requires team enrollment and a Number with an Official API connection.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-required-scope": "sessions:read",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "description": "Number ID."
            },
            "required": true,
            "name": "session",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/GetMarketingMessagesStatusResponse"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
            }
          },
          "400": {
            "description": "The Number ID fails validation (`invalid_parameter`); it must contain 1 to 128 characters.",
