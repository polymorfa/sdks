{
  "paths": {
    "/messaging/{session}/official-groups/{group}/picture": {
      "put": {
        "operationId": "setOfficialGroupPicture",
        "tags": ["Official groups"],
        "summary": "Set an Official group picture",
        "description": "**Protocols:** Meta Cloud API\n\n**Required scope:** `groups:manage`\n\nReplaces the group's profile picture. Send `multipart/form-data` with one `file` part: a square JPEG of at least 192 x 192 pixels and at most 5 MB. A `group.update` event with action `settings_updated` reports whether WhatsApp applied it. Repeating the same upload is safe. Beta: requires team enrollment and a Number with an Official API connection whose WhatsApp Business Account is an Official Business Account.",
        "security": [
          {
            "BearerAuth": []
          }
        ],
        "x-required-scope": "groups:manage",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "description": "Number ID."
            },
            "required": true,
            "name": "session",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "pattern": "^[1-9][0-9]{0,18}$",
              "description": "Conversation ID of the group.",
              "example": "739182640518203"
            },
            "required": true,
            "name": "group",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/SetOfficialGroupPictureRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SetOfficialGroupPictureResponse"
                }
              }
            },
            "headers": {
              "X-RateLimit-Limit": {
                "$ref": "#/components/headers/X-RateLimit-Limit"
              },
              "X-RateLimit-Remaining": {
                "$ref": "#/components/headers/X-RateLimit-Remaining"
              },
              "X-RateLimit-Reset": {
                "$ref": "#/components/headers/X-RateLimit-Reset"
              }
