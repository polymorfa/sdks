      "paths": {
        "/api/account/features/evaluate": {
          "post": {
            "operationId": "evaluateAccountFeatures",
            "tags": ["Feature availability"],
            "summary": "Evaluate feature availability",
            "description": "Evaluate feature decisions for the live dashboard organization from each feature's published setting. No permission is granted by a decision. Features not offered to the team are omitted unless the team is enrolled; opt-in features include their terms before enrollment, and enrolled features stay visible for withdrawal.\n\nRequires a verified dashboard bearer and current organization authorization. Organization keys and project tokens are not accepted.",
            "x-audience": "console",
            "x-polymorfa-resource-boundary": "human_only",
            "x-excluded-from-public": true,
            "x-exclusion-reason": "Private dashboard feature discovery; requires live organization membership.",
            "security": [{ "ConsoleSession": [] }],
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["surface", "keys"],
                    "properties": {
                      "surface": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                        "maxLength": 100
                      },
                      "keys": {
                        "type": "array",
                        "maxItems": 50,
                        "items": {
                          "type": "string",
                          "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                          "maxLength": 100
                        }
                      },
                      "measurementAllowed": {
                        "type": "boolean",
                        "default": false,
                        "description": "Deprecated. Has no effect."
                      },
                      "projectId": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Optional active project in the signed-in team. Required when checking a project-targeted release."
                      },
                      "locale": {
                        "type": "string",
                        "enum": ["en", "pt-BR"],
                        "default": "en",
                        "description": "Language for titles, descriptions and terms. Missing translations fall back to English."
                      }
                    }
                  }
                }
              }
            },
            "responses": {
              "200": {
                "description": "Success",
                "headers": {
                  "X-Request-Id": {
                    "schema": { "type": "string" },
                    "description": "Stable request correlation identifier."
                  },
                  "X-Trace-Id": {
                    "schema": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
                    "description": "W3C trace ID of this request. Your `traceparent` trace ID when you sent a valid one."
                  },
                  "Polymorfa-Version": {
                    "schema": { "type": "string" },
                    "description": "API version applied to this response."
                  },
                  "Cache-Control": {
                    "schema": { "type": "string", "example": "no-store" }
                  }
                },
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "success": { "type": "boolean", "enum": [true] },
                        "data": {
                          "type": "array",
                          "items": {
                            "type": "object",
                            "required": [
                              "decision",
                              "title",
                              "description",
                              "state",
                              "termsRevision",
                              "terms",
                              "withdrawal",
                              "enrollmentSource",
                              "exposureToken"
                            ],
                            "properties": {
                              "decision": {
                                "type": "object",
                                "required": [
                                  "key",
                                  "version",
                                  "available",
                                  "enrolled",
                                  "variant",
                                  "experimentRevision",
                                  "experimentAssigned"
                                ],
                                "properties": {
                                  "key": {
                                    "type": "string",
                                    "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                                    "maxLength": 100
                                  },
                                  "version": {
                                    "type": "integer",
                                    "minimum": 1
                                  },
                                  "available": { "type": "boolean" },
                                  "enrolled": { "type": "boolean" },
                                  "variant": {
                                    "type": "string",
                                    "nullable": true
                                  },
                                  "experimentRevision": {
                                    "type": "integer",
                                    "minimum": 1,
                                    "nullable": true,
                                    "description": "Published experiment policy revision for an assigned native experiment; null otherwise."
                                  },
                                  "experimentAssigned": {
                                    "type": "boolean",
                                    "description": "True only when an experiment assigned a registered variant with measurement enabled."
                                  }
                                }
                              },
                              "title": { "type": "string" },
                              "description": { "type": "string" },
                              "state": {
                                "type": "string",
                                "enum": ["off", "opt_in", "on"],
                                "description": "Published access state. `opt_in` requires the team to accept `terms` before the feature is available."
                              },
                              "termsRevision": {
                                "type": "string",
                                "nullable": true,
                                "description": "Current terms revision while the feature is opt-in; null otherwise."
                              },
                              "terms": {
                                "type": "string",
                                "nullable": true,
                                "description": "Opt-in terms in the requested locale; null when the feature is not opt-in."
                              },
                              "withdrawal": {
                                "type": "string",
                                "nullable": true
                              },
                              "enrollmentSource": {
                                "type": "string",
                                "nullable": true,
                                "enum": ["customer", "staff", null],
                                "description": "Who enabled an opt-in feature for the team: a team owner or admin, or Polymorfa. Null when not enrolled."
                              },
                              "exposureToken": {
                                "nullable": true,
                                "description": "Deprecated. Always null."
                              }
                            }
                          }
                        }
                      },
                      "required": ["success", "data"]
                    }
                  }
                }
              },
              "400": { "$ref": "#/components/responses/BadRequest" },
              "401": { "$ref": "#/components/responses/Unauthorized" },
              "403": { "$ref": "#/components/responses/Forbidden" },
              "413": { "$ref": "#/components/responses/PayloadTooLarge" },
              "500": { "$ref": "#/components/responses/InternalError" }
            }
          }
        },
        "/api/account/features/enrollment": {
          "post": {
            "operationId": "setFeatureEnrollment",
            "tags": ["Feature availability"],
            "summary": "setFeatureEnrollment",
            "description": "Live organization owner/admin only. Enabling requires the feature's published opt-in setting, its current terms revision, entitlement, release eligibility and no operational disable; a terms change during the request returns 409. Withdrawal does not delete resources.\n\nRequires a verified dashboard bearer and current organization authorization. The signed-in member must be an organization owner or admin. Organization keys and project tokens are not accepted.",
            "x-audience": "console",
            "x-polymorfa-resource-boundary": "human_only",
            "x-excluded-from-public": true,
            "x-exclusion-reason": "Private beta enrollment; requires live organization owner or admin authority.",
            "x-required-organization-role": "owner_or_admin",
            "security": [{ "ConsoleSession": [] }],
            "requestBody": {
              "required": true,
              "content": {
                "application/json": {
                  "schema": {
                    "type": "object",
                    "additionalProperties": false,
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)*$",
                        "maxLength": 100
                      },
                      "enabled": { "type": "boolean" },
                      "termsRevision": {
                        "type": "string",
                        "nullable": true,
                        "maxLength": 100
                      },
                      "projectId": {
                        "type": "string",
                        "format": "uuid",
                        "description": "Optional active project in the signed-in team for a project-targeted release."
                      }
                    },
                    "required": ["key", "enabled", "termsRevision"]
                  }
                }
              }
            },
            "responses": {
              "200": {
                "description": "Success",
                "headers": {
                  "X-Request-Id": {
                    "schema": { "type": "string" },
                    "description": "Stable request correlation identifier."
                  },
                  "X-Trace-Id": {
                    "schema": { "type": "string", "pattern": "^[0-9a-f]{32}$" },
                    "description": "W3C trace ID of this request. Your `traceparent` trace ID when you sent a valid one."
                  },
                  "Polymorfa-Version": {
                    "schema": { "type": "string" },
                    "description": "API version applied to this response."
                  }
                },
                "content": {
                  "application/json": {
                    "schema": {
                      "type": "object",
                      "additionalProperties": false,
                      "properties": {
                        "success": { "type": "boolean", "enum": [true] },
                        "data": {
                          "type": "object",
                          "required": ["enabled", "termsRevision"],
                          "properties": {
                            "enabled": { "type": "boolean" },
                            "termsRevision": { "type": "string" },
                            "capture": {
                              "type": "object",
                              "description": "Present for features that control data capture: whether capture already follows the change for every affected Number (`applied`) or is still being brought in line (`pending`).",
                              "additionalProperties": false,
                              "required": ["state"],
                              "properties": {
                                "state": {
                                  "type": "string",
                                  "enum": ["applied", "pending"]
                                }
                              }
                            }
                          }
                        }
                      },
                      "required": ["success", "data"]
                    }
                  }
                }
              },
              "400": { "$ref": "#/components/responses/BadRequest" },
              "401": { "$ref": "#/components/responses/Unauthorized" },
              "403": { "$ref": "#/components/responses/Forbidden" },
              "404": { "$ref": "#/components/responses/NotFound" },
              "409": { "$ref": "#/components/responses/Conflict" },
              "413": { "$ref": "#/components/responses/PayloadTooLarge" },
              "500": { "$ref": "#/components/responses/InternalError" }
            }
          }
        },
        "/api/account/features/exposure": {
          "post": {
            "operationId": "recordFeatureExposure",
            "tags": ["Feature availability"],
            "summary": "recordFeatureExposure",
            "description": "Deprecated. Exposure measurement is not recorded through this route; it always returns 403.\n\nRequires a verified dashboard bearer and current organization authorization. Organization keys and project tokens are not accepted.",
            "x-audience": "console",
            "x-polymorfa-resource-boundary": "human_only",
