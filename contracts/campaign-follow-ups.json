      "schemas": {
        "CampaignFollowUp": {
          "type": "object",
          "additionalProperties": false,
          "required": ["message"],
          "description": "One optional receipt-timed follow-up, sent from the Number that sent the first message. A beta; a team that is not enrolled gets `403 feature_unavailable`. Expiry must exceed delay and is counted from the first send. Configuration freezes at launch. The first read takes precedence over the first delivery; additional reads do not move it. Replies and opt-outs cancel it. Without a delivery or read receipt it never arms, and an expired wait never sends. Requires a single first message, and the text cannot contain tracked links.",
          "properties": {
            "delaySeconds": {
              "type": "integer",
              "minimum": 60,
              "maximum": 604800,
              "default": 86400
            },
            "expirySeconds": {
              "type": "integer",
              "minimum": 86400,
              "maximum": 2592000,
              "default": 604800
            },
            "message": {
              "oneOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "text"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["text"]
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 16384
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["type", "templateId"],
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": ["template"]
                    },
                    "templateId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              ]
            }
          }
        },
