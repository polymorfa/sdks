{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Verified Polymorfa documentation snippets",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "sourceCommit",
    "sourceFilesSha256",
    "apiVersion",
    "apiSourceCommit",
    "specs",
    "releaseStatus",
    "packages",
    "operations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "sourceFilesSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "apiVersion": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "apiSourceCommit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "specs": {
      "type": "object",
      "required": ["messaging", "platform"],
      "additionalProperties": false,
      "properties": {
        "messaging": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "platform": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "releaseStatus": {
      "const": "source-only"
    },
    "packages": {
      "type": "object",
      "additionalProperties": false,
      "required": ["typescript", "go", "python", "php", "dotnet", "rust"],
      "properties": {
        "typescript": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "go": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "python": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "php": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "dotnet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "rust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "version"],
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "operations": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["family", "method", "path", "credentialKind", "request"],
        "properties": {
          "family": {
            "enum": ["messaging", "platform"]
          },
          "method": {
            "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"]
          },
          "path": {
            "type": "string",
            "pattern": "^/"
          },
          "credentialKind": {
            "const": "organization_api_key"
          },
          "request": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "body": {
                "type": "object"
              },
              "query": {
                "type": "object"
              }
            }
          },
          "typescript": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "go": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "python": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "php": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "dotnet": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "rust": {
            "type": "object",
            "additionalProperties": false,
            "required": ["code"],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "anyOf": [
          {
            "required": ["typescript"]
          },
          {
            "required": ["go"]
          },
          {
            "required": ["python"]
          },
          {
            "required": ["php"]
          },
          {
            "required": ["dotnet"]
          },
          {
            "required": ["rust"]
          }
        ]
      }
    }
  }
}
